# =============================================================================
# Market Orca — Root Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Backend-specific config: backend/.env.example
# Frontend-specific config: frontend/.env.example
# =============================================================================

# ── Cloudflare Tunnel ─────────────────────────────────────────────────
# Get token from: Cloudflare Dashboard → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE

# ── MCP Auth (optional) ──────────────────────────────────────────────
# Random string for MCP HTTP endpoint auth (leave empty to disable)
MCP_AUTH_TOKEN=YOUR_RANDOM_SECRET_TOKEN_HERE

# ── Docker Compose Dev Services ───────────────────────────────────────
POSTGRES_USER=dev
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_USER=dev
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── SearXNG ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SEARXNG_SECRET_KEY=CHANGE_ME_RANDOM_HEX_32_BYTES
