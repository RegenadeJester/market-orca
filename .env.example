# =============================================================================
# Market Orca — Root Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Backend-specific config: backend/.env.example
# Frontend-specific config: frontend/.env.example
# =============================================================================

# ── Cloudflare Tunnel ─────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── MCP Auth (optional) ──────────────────────────────────────────────
# MCP_AUTH_TOKEN=

# ── Docker Compose Dev Services ───────────────────────────────────────
POSTGRES_USER=dev
POSTGRES_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=dev
MYSQL_PASSWORD=changeme

# ── SearXNG ───────────────────────────────────────────────────────────
SEARXNG_SECRET_KEY=changeme
