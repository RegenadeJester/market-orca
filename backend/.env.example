# =====================================================================
# Market Orca — Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =====================================================================

# ── Server ──────────────────────────────────────────────────────────
PORT=4567
REPORT_PORT=4568
LAN_IP=YOUR_LAN_IP
TAILSCALE_IP=YOUR_TAILSCALE_IP
PUBLIC_BASE_URL=https://YOUR_DOMAIN_HERE
TAILSCALE_BASE_URL=http://YOUR_TAILSCALE_IP:4567
FRONTEND_URL=https://YOUR_DOMAIN_HERE
FRONTEND_TAILSCALE_URL=http://YOUR_TAILSCALE_IP:5173

# ── Discord ─────────────────────────────────────────────────────────
# Webhook URL: Discord Server Settings → Integrations → Webhooks → New
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_STATUS_WEBHOOK_URL=
# Bot token: Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
DISCORD_USER_ID=YOUR_DISCORD_USER_ID
# Set to 1 to disable Discord notifications
NO_DISCORD=0

# ── MCP ─────────────────────────────────────────────────────────────
MCP_PORT=1788
MCP_HOST=0.0.0.0
MCP_PATH=/mcp
# Random string for MCP auth (must match root .env MCP_AUTH_TOKEN)
MCP_AUTH_TOKEN=YOUR_RANDOM_SECRET_TOKEN_HERE
MCP_RATE_LIMIT_PER_MIN=120

# ── AI / LLM ────────────────────────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional: use other LLM providers (Anthropic, etc.)
LLM_API_KEY=
LLM_BASE_URL=
REPORT_REWRITE_MODEL=

# ── Search ──────────────────────────────────────────────────────────
# SearXNG: run docker compose -f docker-compose.searxng.yml up -d
SEARXNG_URL=http://127.0.0.1:18080
SEARX_URL=
# Get key: https://perplexity.ai → Settings → API
PERPLEXITY_API_KEY=pplx-YOUR_PERPLEXITY_API_KEY_HERE

# ── Cloudflare Tunnel ───────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE

# ── RAG / Crawler ──────────────────────────────────────────────────
RAG_ALLOWED_DOMAINS=idx.co.id,bi.go.id,ojk.go.id,reuters.com,bloomberg.com

# ── SSRF Protection ────────────────────────────────────────────────
MCP_FETCH_MAX_REDIRECTS=3
MCP_FETCH_TIMEOUT_MS=12000
MCP_FETCH_ALLOWED_DOMAINS=
SSRF_DNS_CACHE_TTL=60000

# ── Export / Persona ───────────────────────────────────────────────
EXPORT_CLEANUP_HOURS=24
EXPORT_MAX_FILE_MB=10
PERSONA_CACHE_TTL_SEC=3600

# ── Docker Dev DB (use strong passwords in production!) ──────────────
POSTGRES_USER=dev
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_USER=dev
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
