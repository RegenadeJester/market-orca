# =====================================================================
# Market Orca — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =====================================================================

# ── Server ──────────────────────────────────────────────────────────
PORT=4567
REPORT_PORT=4568
LAN_IP=192.168.x.x
TAILSCALE_IP=100.x.x.x
PUBLIC_BASE_URL=https://market-orca.example.com
TAILSCALE_BASE_URL=http://100.x.x.x:4567
FRONTEND_URL=https://market-orca.example.com
FRONTEND_TAILSCALE_URL=http://100.x.x.x:5173

# ── Discord ─────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
DISCORD_STATUS_WEBHOOK_URL=
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_GUILD_ID
DISCORD_USER_ID=YOUR_DISCORD_USER_ID
NO_DISCORD=1

# ── MCP ─────────────────────────────────────────────────────────────
MCP_PORT=1788
MCP_HOST=0.0.0.0
MCP_PATH=/mcp
MCP_AUTH_TOKEN=YOUR_RANDOM_SECRET_TOKEN
MCP_RATE_LIMIT_PER_MIN=120

# ── AI / LLM ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
REPORT_REWRITE_MODEL=

# ── Search ──────────────────────────────────────────────────────────
SEARXNG_URL=http://127.0.0.1:18080
SEARX_URL=
PERPLEXITY_API_KEY=pplx-YOUR_PERPLEXITY_KEY

# ── Cloudflare Tunnel ───────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN

# ── RAG / Crawler ──────────────────────────────────────────────────
RAG_ALLOWED_DOMAINS=idx.co.id,bi.go.id,ojk.go.id,reuters.com,bloomberg.com

# ── SSRF Protection ────────────────────────────────────────────────
MCP_FETCH_MAX_REDIRECTS=3
MCP_FETCH_TIMEOUT_MS=12000
MCP_FETCH_ALLOWED_DOMAINS=
SSRF_DNS_CACHE_TTL=60000

# ── Export / Persona ───────────────────────────────────────────────
EXPORT_CLEANUP_HOURS=24
EXPORT_MAX_FILE_MB=10
PERSONA_CACHE_TTL_SEC=3600

# ── Docker Dev DB (passwords — use strong values in prod) ───────────
POSTGRES_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme
